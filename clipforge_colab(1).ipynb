   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🖥️ Section 12: Launch Custom Premium Web Interface\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ==========================================\n",
    "# 12. WEB SERVER & BACKGROUND TUNNEL SERVICES\n",
    "# ==========================================\n",
    "import os\n",
    "import sys\n",
    "import time\n",
    "import subprocess\n",
    "import re\n",
    "import urllib.request\n",
    "import shutil\n",
    "import platform\n",
    "from pathlib import Path\n",
    "\n",
    "# 1. Dynamic Project path detection\n",
    "def find_project_root():\n",
    "    cwd = Path.cwd()\n",
    "    if (cwd / \"frontend\" / \"index.html\").exists() and (cwd / \"backend\" / \"server.py\").exists():\n",
    "        return cwd\n",
    "    for p in cwd.glob(\"**/frontend/index.html\"):\n",
    "        root = p.parent.parent\n",
    "        if (root / \"backend\" / \"server.py\").exists():\n",
    "            return root\n",
    "    if os.path.exists(\"/content\"):\n",
    "        content = Path(\"/content\")\n",
    "        if (content / \"frontend\" / \"index.html\").exists() and (content / \"backend\" / \"server.py\").exists():\n",
    "            return content\n",
    "        for p in content.glob(\"**/frontend/index.html\"):\n",
    "            root = p.parent.parent\n",
    "            if (root / \"backend\" / \"server.py\").exists():\n",
    "                return root\n",
    "    return None\n",
    "\n",
    "project_root = find_project_root()\n",
    "if not project_root:\n",
    "    raise FileNotFoundError(\n",
    "        \"❌ ClipForge project assets not found.\\n\"\n",
    "        \"Expected frontend/index.html and backend/server.py.\\n\"\n",
    "        \"Please upload/extract the complete project.\"\n",
    "    )\n",
    "\n",
    "print(f\"✓ Project detected at: {project_root.resolve()}\")\n",
    "os.chdir(project_root)\n",
    "if str(project_root.resolve()) not in sys.path:\n",
    "    sys.path.insert(0, str(project_root.resolve()))\n",
    "\n",
    "# 2. Dependency check (already installed in Cell 2)\n",
    "import fastapi\n",
    "import uvicorn\n",
    "import nest_asyncio\n",
    "\n",
    "# Install cloudflared on Linux if running in Colab\n",
    "is_colab = os.path.exists(\"/content\")\n",
    "cloudflared_path = \"/usr/local/bin/cloudflared\"\n",
    "if is_colab and not os.path.exists(cloudflared_path):\n",
    "    print(\"📥 Downloading Cloudflare Tunnel (cloudflared)...\")\n",
    "    url = \"https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64\"\n",
    "    try:\n",
    "        urllib.request.urlretrieve(url, \"/tmp/cloudflared\")\n",
    "        shutil.move(\"/tmp/cloudflared\", cloudflared_path)\n",
    "        subprocess.run([\"chmod\", \"+x\", cloudflared_path], check=True)\n",
    "        print(\"✓ cloudflared installed successfully.\")\n",
    "    except Exception as e:\n",
    "        print(f\"❌ Failed to download cloudflared: {e}\")\n",
    "\n",
    "# 3. Startup Configuration\n",
    "port = int(os.environ.get(\"PORT\", 8000))\n",
    "backend_log_file = project_root / \"backend.log\"\n",
    "cf_log_file = project_root / \"cloudflare.log\"\n",
    "\n",
    "# Clear old log files\n",
    "if backend_log_file.exists():\n",
    "    backend_log_file.unlink()\n",
    "if cf_log_file.exists():\n",
    "    cf_log_file.unlink()\n",
    "\n",
    "# 4. Start Backend Process\n",
    "print(\"🚀 Starting ClipForge Premium Backend Server...\")\n",
    "backend_log = open(backend_log_file, \"w\")\n",
    "backend_proc = subprocess.Popen(\n",
    "    [sys.executable, \"backend/run_server.py\"],\n",
    "    stdout=backend_log,\n",
    "    stderr=subprocess.STDOUT,\n",
    "    env={**os.environ, \"PORT\": str(port)},\n",
    "    text=True\n",
    ")\n",
    "\n",
    "# Wait for backend to start and verify it's running\n",
    "time.sleep(3)\n",
    "if backend_proc.poll() is not None:\n",
    "    with open(backend_log_file, \"r\") as f:\n",
    "        log_content = f.read()\n",
    "    print(\"❌ Backend Server failed to start! Log output:\")\n",
    "    print(log_content)\n",
    "    sys.exit(1)\n",
    "\n",
    "print(f\"✓ Backend started successfully! (PID: {backend_proc.pid}, Port: {port})\")\n",
    "\n",
    "# 5. Start Cloudflare Tunnel Process\n",
    "print(\"🌐 Starting Cloudflare Tunnel...\")\n",
    "cf_log = open(cf_log_file, \"w\")\n",
    "cf_cmd = [\"cloudflared\", \"tunnel\", \"--url\", f\"http://localhost:{port}\"]\n",
    "if not is_colab and platform.system() == \"Windows\":\n",
    "    cf_cmd[0] = \"cloudflared.exe\"\n",
